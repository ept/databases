// One relation per table. Datalog has no NULL, so a nullable column
// becomes a relation of its own, with a fact only where it is known.
.decl movies(movie_id: symbol, title: symbol, year: number,
             type: symbol, minutes: number)
.decl people(person_id: symbol, name: symbol)
.decl birthyear(person_id: symbol, year: number)
.decl deathyear(person_id: symbol, year: number)
.decl genres(genre_id: number, name: symbol)
.decl has_genre(movie_id: symbol, genre_id: number)
.decl ratings(movie_id: symbol, rating: float, votes: number)
.decl has_position(person_id: symbol, movie_id: symbol,
                   position: symbol)
.decl job(person_id: symbol, movie_id: symbol, position: symbol,
          job: symbol)
.decl plays_role(person_id: symbol, movie_id: symbol, role: symbol)

// Where movies were filmed (from Wikidata). Each place is located_in
// one or more larger places, up to a continent.
.decl places(place_id: symbol, name: symbol)
.decl located_in(place_id: symbol, parent_id: symbol)
.decl filmed_at(movie_id: symbol, place_id: symbol)

.input movies, people, birthyear, deathyear, genres, has_genre, ratings,
       has_position, job, plays_role, places, located_in, filmed_at
