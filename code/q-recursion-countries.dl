#include "movies-schema.dl"

.decl within(place_id: symbol, area_id: symbol)
within(p, a) :- located_in(p, a).
within(p, a) :- located_in(p, q), within(q, a).

.decl filmed_within(movie_id: symbol, area_id: symbol)
filmed_within(m, a) :- filmed_at(m, a).
filmed_within(m, a) :- filmed_at(m, p), within(p, a).

// A continent is not located in any other place, and a country
// is located directly in a continent
.decl continent(place_id: symbol)
continent(c) :- places(c, _), !located_in(c, _).
.decl country(place_id: symbol)
country(p) :- located_in(p, c), continent(c).

.decl result(country: symbol, movies: number)
result(name, n) :- country(p), places(p, name),
                   n = count : { filmed_within(_, p) }.
.output result
